 #include <fcitx/candidatelist.h>
 
 #include <algorithm>
@@ -128,6 +129,9 @@ void HazkeyState::preeditKeyEvent(
 
     switch (keysym) {
         case FcitxKey_Return:
+            // Keep the committed text as context: the application may not have
+            // updated its surrounding text yet when the next composition starts.
+            updateSurroundingText(preedit_.text());
             preedit_.commitPreedit();
             if (livePreeditIndex_ >= 0) {
                 engine_->server().completePrefix(livePreeditIndex_);
@@ -197,6 +201,7 @@ void HazkeyState::preeditKeyEvent(
                 }
             } else if (isInputableEvent(event)) {
                 if (isDirectConversionMode_) {
+                    updateSurroundingText(preedit_.text());
                     preedit_.commitPreedit();
                     reset();
                 }
@@ -316,11 +321,45 @@ void HazkeyState::updateSurroundingText(std::string appendText) {
     if (ic_->capabilityFlags().test(CapabilityFlag::SurroundingText) &&
         ic_->surroundingText().isValid()) {
         auto& surroundingText = ic_->surroundingText();
-        engine_->server().setContext(
-            surroundingText.text() + appendText,
-            surroundingText.anchor() + appendText.length());
+        const std::string text = surroundingText.text();
+        const unsigned int anchor = surroundingText.anchor();
+        const bool changed =
+            !hasSurroundingText_ || text != lastSurroundingText_ ||
+            anchor != lastSurroundingAnchor_;
+
+        if (!appendText.empty()) {
+            // Commit: extend the latest known text with the committed string.
+            if (changed || pendingSurroundingText_.empty()) {
+                pendingSurroundingText_ = text;
+                pendingSurroundingAnchor_ = anchor;
+            }
+            pendingSurroundingText_ += appendText;
+            pendingSurroundingAnchor_ += utf8::length(appendText);
+            lastSurroundingText_ = text;
+            lastSurroundingAnchor_ = anchor;
+            hasSurroundingText_ = true;
+            engine_->server().setContext(
+                pendingSurroundingText_, pendingSurroundingAnchor_);
+            return;
+        }
+
+        // New composition: refresh from the app unless it still reports the
+        // text from before our last commit. In that case the context sent at
+        // commit time already includes the committed text, so keep it instead
+        // of overwriting it with the stale value.
+        if (!pendingSurroundingText_.empty() && !changed) {
+            pendingSurroundingText_.clear();
+            return;
+        }
+        pendingSurroundingText_.clear();
+        lastSurroundingText_ = text;
+        lastSurroundingAnchor_ = anchor;
+        hasSurroundingText_ = true;
+        engine_->server().setContext(text, anchor);
     } else {
         engine_->server().setContext("", 0);
+        hasSurroundingText_ = false;
+        pendingSurroundingText_.clear();
     }
 }
 
