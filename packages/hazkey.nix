{
  lib,
  stdenv,
  callPackage,
  fetchFromGitHub,
  cmake,
  ninja,
  git,
  swift,
  swiftpm,
  swiftpm2nix,
  jq,
  gettext,
  pkg-config,
  patchelf,
  protobuf,
  fcitx5,
  qt6,
  version ? "0.2.1",
  vulkanSupport ? false,
}:

let
  # Vendored SwiftPM dependency sources + configure snippet, generated by swiftpm2nix.
  generated = swiftpm2nix.helpers ./hazkey/swiftpm;

  # llama.cpp (7ka-hiira fork) providing libllama for the Zenzai backend.
  llamaCpp = callPackage ./llama.nix { inherit version vulkanSupport; };
in
stdenv.mkDerivation {
  pname = "hazkey";
  inherit version;

  src = fetchFromGitHub {
    owner = "7ka-hiira";
    repo = "hazkey";
    rev = "23c78b1a35f828288061145c6dfc73dc53916667";
    hash = "sha256-0seZNJwVZgpq04TCTtgqGMwelbodAuLRc3ARzStW0lQ=";
    fetchSubmodules = true;
  };

  strictDeps = true;
  __structuredAttrs = true;

  # AzooKeyKanaKanjiConverter's Zenzai trait declares `.systemLibrary(name: "llama.cpp")`,
  # so SwiftPM looks up `llama.cpp.pc` through pkg-config. Our llama.cpp build only installs
  # `llama.pc`, so provide a `llama.cpp.pc` pointing at the local build.
  env.PKG_CONFIG_PATH = "$NIX_BUILD_TOP/llama-pc:${llamaCpp}/lib/pkgconfig";

  nativeBuildInputs = [
    cmake
    ninja
    git
    swift
    swiftpm
    swiftpm2nix
    jq
    gettext
    pkg-config
    patchelf
    protobuf
    qt6.wrapQtAppsHook
  ];

  buildInputs = [
    # `swift` is also a build input so the Swift runtime libraries
    # (libswiftCore.so, ...) end up on the RPATH of the built binaries.
    swift
    fcitx5
    protobuf
    qt6.qtbase
    qt6.qttools
    llamaCpp
  ];

  postPatch = ''
    # Make SwiftPM use the package-local `.build` directory (where swiftpm2nix
    # vendors the dependencies) instead of a separate `--scratch-path`, which
    # would make SwiftPM re-resolve dependencies over the network.
    substituteInPlace hazkey-server/build_swift.cmake \
      --replace-fail '"--scratch-path=''${CMAKE_CURRENT_BINARY_DIR}/swift-build"' ""

    # nixpkgs' Swift ships no static stdlib; link the shared runtime instead.
    # Also, modern abseil/protobuf headers require C++20.
    substituteInPlace hazkey-settings/CMakeLists.txt \
      --replace-fail 'set(CMAKE_CXX_STANDARD 17)' 'set(CMAKE_CXX_STANDARD 20)'
  '';

  configurePhase = ''
    runHook preConfigure

    mkdir -p "$NIX_BUILD_TOP/llama-pc"
    cat > "$NIX_BUILD_TOP/llama-pc/llama.cpp.pc" <<'EOF'
    prefix=${llamaCpp}
    libdir=${llamaCpp}/lib
    includedir=${llamaCpp}/include
    Name: llama.cpp
    Description: llama.cpp (7ka-hiira fork) for Hazkey Zenzai
    Version: ${version}
    Libs: -L${llamaCpp}/lib -lggml -lggml-base -lllama
    Cflags: -I${llamaCpp}/include
    EOF

    # Vendor SwiftPM dependencies (edit mode) into hazkey-server/.build.
    # swiftpm2nix's helpers resolve paths against $NIX_BUILD_TOP/$sourceRoot.
    (
      cd hazkey-server
      export sourceRoot=source/hazkey-server
      ${generated.configure}

      # The vendored sources live in read-only store paths. SwiftPM's resource
      # copy step needs a writable directory (it creates the destination with the
      # source's mode), so make the package with resources mutable.
      swiftpmMakeMutable AzooKeyKanaKanjiConverter
    )

    cmake -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=$out \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DProtobuf_USE_STATIC_LIBS=OFF \
      -DHAZKEY_SERVER_BUILD_LLAMA_LIBS=OFF \
      -DHAZKEY_SERVER_INSTALL_LLAMA_LIBS=OFF \
      -DHAZKEY_SERVER_ZENZAI_TRAIT=ON \
      -DHAZKEY_SERVER_STATIC_SWIFT_STDLIB=OFF \
      -DHAZKEY_SERVER_LIBLLAMA_BINDIR=${llamaCpp}/lib

    runHook postConfigure
  '';

  buildPhase = ''
    runHook preBuild
    cmake --build build -j "$NIX_BUILD_CORES"
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall

    # hazkey-server/CMakeLists.txt installs the Swift binary from the
    # CMake binary dir's `swift-build` subdirectory. Since we removed the custom
    # scratch path, point that location at the default `.build` directory.
    mkdir -p build/hazkey-server
    ln -sfn "$NIX_BUILD_TOP/source/hazkey-server/.build" build/hazkey-server/swift-build

    cmake --install build

    # Install llama.cpp libraries next to the server (see hazkey-server/CMakeLists.txt).
    # ggml installs the dynamically-loaded CPU backend into `bin/`; llama.cpp
    # searches for it in `<libdir>/backends`.
    mkdir -p "$out/lib/hazkey/libllama/backends"
    cp "${llamaCpp}/lib/libggml-base.so" \
       "${llamaCpp}/lib/libggml.so" \
       "${llamaCpp}/lib/libllama.so" \
       "$out/lib/hazkey/libllama/"
    cp "${llamaCpp}"/bin/*.so "$out/lib/hazkey/libllama/backends/"

    runHook postInstall
  '';

  # The Swift server links libllama from its sibling libllama directory.
  postFixup = ''
    for f in "$out/lib/hazkey/hazkey-server" "$out/lib/hazkey/hazkey-settings"; do
      if [ -e "$f" ]; then
        patchelf --add-rpath "$out/lib/hazkey/libllama" "$f"
      fi
    done

    # ggml backends resolve libggml-base.so from the parent directory.
    for f in "$out"/lib/hazkey/libllama/backends/*.so; do
      if [ -e "$f" ]; then
        patchelf --add-rpath '$ORIGIN/..' "$f"
      fi
    done
  '';

  meta = {
    description = "Japanese input method engine (fcitx5 addon + Swift server)";
    homepage = "https://github.com/7ka-Hiira/hazkey";
    license = lib.licenses.mit;
    platforms = lib.platforms.linux;
    mainProgram = "hazkey-server";
  };
}
