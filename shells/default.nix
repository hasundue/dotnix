{
  pkgs,
  treefmt-nix,
  git-hooks-nix,
}:
let
  system = pkgs.stdenv.hostPlatform.system;
  treefmt = treefmt-nix.lib.mkWrapper pkgs {
    projectRootFile = "flake.nix";
    programs = {
      deno.enable = true;
      nixfmt.enable = true;
    };
    settings.formatter.deno.excludes = [
      # Generated by swiftpm2nix; keep it byte-identical to SwiftPM's output so
      # the hazkey derivation hash stays stable.
      "packages/hazkey/swiftpm/workspace-state.json"
    ];
  };
  git-hooks = git-hooks-nix.lib.${system}.run {
    src = ../.;
    hooks = {
      treefmt = {
        enable = true;
        package = treefmt;
      };
    };
  };
in
pkgs.mkShellNoCC {
  packages = with pkgs; [
    act
    deno
    nil
    nixfmt
    treefmt
  ];
  shellHook = git-hooks.shellHook;
}
